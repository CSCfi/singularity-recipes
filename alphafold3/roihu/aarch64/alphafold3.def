Bootstrap: docker
From: satama.csc.fi/r_installation_spack/core-gpu-gcc-13.4.0-cuda-12.6.3:v2026_03

%post
    # Activate module environment and load default modules.
    . /opt/activate.sh

    # Install tools
    dnf install -y python3.12 python3.12-devel
    dnf install -y git curl wget zlib-devel zstd patch

    # Install uv
    export UV_INSTALL_DIR=/usr/local/bin
    curl -LsSf https://astral.sh/uv/install.sh | sh

    # Set environment variables for uv
    export UV_LINK_MODE=copy
    export UV_CACHE_DIR=/opt/uv
    export UV_PYTHON_CACHE_DIR=/opt/uv
    export UV_PYTHON_BIN_DIR=/opt/uv
    export UV_PYTHON_INSTALL_DIR=/opt/uv
    export UV_TOOL_BIN_DIR=/opt/uv
    export UV_TOOL_DIR=/opt/uv
    export UV_COMPILE_BYTECODE=1

    # Download alphafold3
    wget https://github.com/google-deepmind/alphafold3/archive/refs/tags/v3.0.4.tar.gz --directory-prefix /opt
    (cd /opt && echo "a12bfec74fe9670d5d6e1897450ccf968422e0b87743ffee82ff0cb4c76f1923 v3.0.4.tar.gz" | sha256sum --check) && \
    (cd /opt && tar zxf v3.0.4.tar.gz && mv alphafold3-3.0.4 alphafold3 && rm v3.0.4.tar.gz)

    # Download, check hash, and extract the HMMER source code.
    mkdir /hmmer_build /hmmer ; \
        wget http://eddylab.org/software/hmmer/hmmer-3.4.tar.gz --directory-prefix /hmmer_build ; \
        (cd /hmmer_build && echo "ca70d94fd0cf271bd7063423aabb116d42de533117343a9b27a65c17ff06fbf3 hmmer-3.4.tar.gz" | sha256sum --check) && \
        (cd /hmmer_build && tar zxf hmmer-3.4.tar.gz && rm hmmer-3.4.tar.gz)

    # Apply the --seq_limit patch to HMMER.
    cp /opt/alphafold3/docker/jackhmmer_seq_limit.patch /hmmer_build/
    (cd /hmmer_build && patch -p0 < jackhmmer_seq_limit.patch)

    # Build HMMER.
    (cd /hmmer_build/hmmer-3.4 && ./configure --prefix /hmmer) && \
    (cd /hmmer_build/hmmer-3.4 && make -j) && \
    (cd /hmmer_build/hmmer-3.4 && make install) && \
    (cd /hmmer_build/hmmer-3.4/easel && make install) && \
    rm -R /hmmer_build

    # Alphafold3
    cd /opt/alphafold3
    uv venv --python 3.12 .venv
    . .venv/bin/activate
    uv sync --frozen --all-groups --no-editable
    uv run build_data

%runscript
    . /opt/activate.sh
    . /opt/alphafold3/.venv/bin/activate
    export PATH=/hmmer/bin:$PATH
    export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false"
    export XLA_PYTHON_CLIENT_PREALLOCATE=true
    export XLA_CLIENT_MEM_FRACTION=0.95
    exec "$@"
